# ==============================================================================
# RESTORA — ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Option A: Local SQLite (default for offline / zero-config development)
DATABASE_URL=sqlite:///./restora.db

# Option B: Supabase PostgreSQL (Replace with your Supabase credentials)
# Go to: Supabase Dashboard -> Project Settings -> Database -> Connection String -> URI
# Mode 1: Transaction Pooler (Recommended for serverless / pooled connections - Port 6543)
# DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-DB-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require

# Mode 2: Direct Connection (Port 5432)
# DATABASE_URL=postgresql://postgres:[YOUR-DB-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require

# ------------------------------------------------------------------------------
# 2. JWT AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
JWT_SECRET_KEY=restora-production-secret-jwt-key-2026-super-secure
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ------------------------------------------------------------------------------
# 3. SUPABASE CLIENT KEYS (OPTIONAL - IF USING CLIENT-SIDE SUPABASE SDK)
# ------------------------------------------------------------------------------
# Found in: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# ------------------------------------------------------------------------------
# 4. SERVER & NETWORK CONFIGURATION
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:8000,http://127.0.0.1:5173,http://127.0.0.1:8000

# ------------------------------------------------------------------------------
# 5. FRONTEND VITE ENVIRONMENT VARIABLES
# ------------------------------------------------------------------------------
VITE_API_URL=http://localhost:8000
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
